# Rumi AI Vision Engine Environment Template
# Copy file ini menjadi .env lalu sesuaikan nilainya dengan environment lokalmu

# Path bobot model YOLO11-pose (prioritas utama: yolo11_rumi.pt)
YOLO_MODEL_PATH=yolo11_rumi.pt

# Threshold deteksi & temporal
CONF_THRESHOLD=0.15
INACTIVITY_SECONDS=1.2

# Pengaturan inferensi & debug window lokal
DEBUG_GUI=true
INFERENCE_TARGET_FPS=10

# Endpoint Backend utama (Rumi-be) untuk pengiriman incident alert & status kamera
API_BASE_URL=http://127.0.0.1:8000
